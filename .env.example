# Mandatory
ENCRYPTION_KEY=replace-with-a-fernet-key-generated-by-python-fernet-generate-key
# Secret key for JWT API authentication
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes-for-hs256

# Administrator account. Set unique values before production use.
PGWARDEN_EMAIL=admin@example.com
PGWARDEN_PASSWORD=replace-with-a-strong-password

# [Optional] Compose already has this default values.
# DB_HOST=pgwarden_db
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=postgres

# Collector storage defaults to PostgreSQL; other services always use PostgreSQL.
# Enable SQLite only in a separately configured collector/migrations environment.
# COLLECTOR_STORAGE_BACKEND=postgresql
# COLLECTOR_SQLITE_PATH=/var/lib/pgwarden/collector.sqlite3

# [Optional] API Port config.
# API_PORT=8080

# [Optional] Dashboard port for full and central server deployments.
# FRONTEND_PORT=3000

# [Optional] Collector/notifier config for the full stack.
# PGWARDEN_CONFIG_FILE=./config.yaml

# [Optional] Comma-separated browser origins allowed to call the API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
