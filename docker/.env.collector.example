ENCRYPTION_KEY=replace-with-a-generated-fernet-key
COLLECTOR_STORAGE_BACKEND=sqlite
COLLECTOR_SQLITE_PATH=/var/lib/pgwarden/collector.sqlite3

# Full receiving endpoint, including the path. Use HTTPS for remote deployments.
SENDER_URL=https://pgwarden.example.com/v1/ingestion/events
SENDER_PROJECT_KEY=pgw_replace-with-project-ingestion-key
SENDER_INTERVAL=5
SENDER_BATCH_SIZE=250
SENDER_TIMEOUT=30
